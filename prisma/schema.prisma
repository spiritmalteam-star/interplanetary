generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// The Laboratory's passage-keepers. Nothing here carries more than the
// minimum: an email, a name the visitor chose, a tier — and their own
// cosmic library. Passwords live only as scrypt hashes; sessions live
// only as signed cookies; nothing is ever sold, shared or read by hand.
// ---------------------------------------------------------------------------

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String?
  passwordHash String? // null → the visitor arrived through Google
  provider     String         @default("email") // email | google
  tier         String         @default("crystalline") // crystalline | light
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  entries      LibraryEntry[]
}

model Usage {
  id     String @id @default(cuid())
  key    String // "user:<id>" or "anon:<uuid>"
  day    String // YYYY-MM-DD (UTC)
  sector String // main | manifest | dreambook | quantum | evolvemed
  count  Int    @default(0)

  @@unique([key, day, sector])
  @@index([key, day])
}

model LibraryEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sector    String // observatory | manifest | dreambook | quantum | evolvemed
  title     String
  excerpt   String
  content   String // JSON: { query, reply, meta }
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
