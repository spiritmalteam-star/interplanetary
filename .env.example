# The laboratory's keys — copy to .env and fill in. NEVER commit .env.

# Local database (SQLite in this sandbox)
DATABASE_URL=file:./db/custom.db

# Cloud sky (Vercel) — the provider bridge switches to OpenAI when set there
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_PROVIDER=openai   # or zai — unset = auto (openai on Vercel, zai in the sandbox)
