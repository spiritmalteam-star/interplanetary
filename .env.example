# The laboratory's keys — copy to .env and fill in. NEVER commit .env.

# Local database (SQLite in this sandbox)
DATABASE_URL=file:./db/custom.db

# --- The Z.ai sky (recommended) — the same GLM brains as the laboratory ---
# Get a key at https://z.ai/manage-apikey/apikey-list (GLM-4.5-Flash is free)
# On Vercel this is the default brain when set.
ZAI_API_KEY=
# ZAI_MODEL=glm-4.5-flash          # chat brain — or glm-4.6 for the flagship
# ZAI_VISION_MODEL=glm-4.6v        # the model that sees uploaded images
# ZAI_IMAGE_MODEL=cogview-3-flash  # free painter — cogview-4 for finer brushes
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# --- the house voice's model knobs (usually leave BOTH unset) ---
# The voice rides the SDK-contract paths (/audio/tts, /audio/asr) and
# those skies serve their own default model — no code needed here.
# Set these ONLY if your gateway demands an explicit model code
# (verified live: on api.z.ai the OpenAI-style paths answer 1211
# "Unknown Model" for the house codes — the legacy "glm-asr" is dead,
# the documented public transcription model is glm-asr-2512):
# ZAI_TTS_MODEL=cogtts              # house speech synthesis (CogTTS)
# ZAI_ASR_MODEL=glm-asr-2512        # house transcription (GLM-ASR)

# --- The voice's own sky (REQUIRED for TTS/ASR on Vercel) ---
# The international api.z.ai has NO speech synthesis; the house voices
# (xiaochen / tongtong) are served by open.bigmodel.cn under glm-tts.
# Get a key at https://open.bigmodel.cn (API Keys) and set it in Vercel
# so the real Z.ai narrator sings in production (no browser fallback).
BIGMODEL_API_KEY=
# BIGMODEL_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# BIGMODEL_TTS_MODEL=glm-tts        # speech synthesis
# BIGMODEL_ASR_MODEL=glm-asr-2512   # transcription

# --- The OpenAI voice (THE CALL'S TTS ONLY) -------------------------
# THE OPENAI LAW: OpenAI serves ONE duty in this house — the live
# call's spoken replies (/api/tts, engine "openai"). It never writes
# the chat (Z.ai + Gemini carry every word), never paints (CogView,
# Gemini, atelier), never sings (Lyria via Gemini). When this key is
# absent the call's voice falls to the Gemini TTS, then the house
# voice - nothing breaks.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TTS_MODEL=gpt-4o-mini-tts   # falls back to tts-1 automatically
# OPENAI_TTS_VOICE=onyx              # the calm, deep male register

# LIGHT CODES - the musical chamber
# THE MUSIC LAW: the sound engine is Google DeepMind's LYRIA through
# the official GEMINI API (Interactions door + @google/genai fallback).
# It is called ONLY server-side; the key never reaches the browser.
# No OpenAI anywhere on the music path - the brief's wording (interpret,
# refine, lyrics) rides the Z.ai/Gemini chat skies.
# GEMINI_API_KEY  (the key below opens the music chamber's door)
# LYRIA_MODEL=lyria-3.5
# LYRIA_PRO_MODEL=lyria-3-pro-preview
# LYRIA_CLIP_MODEL=lyria-3-clip-preview   (the retired clip door rests)
# LC_DAILY_PREVIEW=15 / LC_DAILY_FULL=4 / LC_DAILY_LOOP=2 / LC_DAILY_GLOBAL=400

# --- The Gemini sky (chat second brain + the music engine + the brush) ---
# GEMINI_API_KEY opens three doors at once:
#   1. the chat's quiet second sky (behind Z.ai) and Albanian's first sky
#   2. the musical chamber (Lyria) - REQUIRED there
#   3. the image brush that stands behind CogView
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Force a sky explicitly: zai-cloud | zai (unset = auto -
# on Vercel the Z.ai key wins, in the laboratory the atelier answers;
# "openai" is no longer honored for the chat - OpenAI speaks only the call)
# LLM_PROVIDER=zai-cloud

# ── THE VISITOR'S WALLET — the creator economy ─────────────────
# The conversation (chat) is FREE forever. The paid creations are the
# music chamber, the book loom and the akashic reading — one wallet
# across them all. Enforcement STANDS by default; set it to "false"
# to lay the weigh down and return every creation to free.
# WALLET_ENFORCED=false
# WALLET_BIRTH_GIFT=500          (the free lights every passage is born holding)
# ── the paid creations' launch prices (credits; live-editable in the
#    keeper's console → PlatformConfig "service_prices") ──
# WALLET_COST_LC_PREVIEW=2       (music preview · 30s)
# WALLET_COST_LC_FULL=5          (music full song · 3+ min)
# WALLET_COST_LC_LOOP=15         (the endless journey · ~30 min loop)
# WALLET_COST_AKASHIC=5          (the akashic creative reading)
# WALLET_COST_BOOK_SHORT=15      (short book — poem / short volumes)
# WALLET_COST_BOOK_LONG=40       (extended book — bedtime / classic / saga)
# ── the credit packs (one wallet across music, books, akashic) ──
# WALLET_PACK_100_CREDITS=100
# WALLET_PACK_100_CENTS=1000
# WALLET_PACK_250_CREDITS=250
# WALLET_PACK_250_CENTS=2000
# WALLET_PACK_700_CREDITS=700
# WALLET_PACK_700_CENTS=5000

# The passes (Stripe is the source of truth for money; when a price id
# is absent the checkout mints its own inline price — nothing invented,
# nothing dead-on-arrival):
#   Seeker          $9.99 / month  — 100 credits every moon
#   Observatory Pro $19.99 / month — 250 credits every moon
#   A pouch of light $4.99 once    — 50 credits held until spent
# WALLET_SEEKER_PRICE_CENTS=999
# WALLET_SEEKER_CREDITS=100
# WALLET_OBSERVATORY_PRO_PRICE_CENTS=1999
# WALLET_OBSERVATORY_PRO_CREDITS=250
# WALLET_TOPUP_PRICE_CENTS=499
# WALLET_TOPUP_CREDITS=50
# Optional pre-created Stripe price ids (else inline price_data):
# STRIPE_PRICE_SEEKER=
# STRIPE_PRICE_OBSERVATORY_PRO=
# STRIPE_PRICE_TOPUP=

# ── STRIPE — the coin keeper's keys ────────────────────────────────
# The secret key never leaves the server; money's truth arrives ONLY
# through the signed webhook (/api/webhooks/stripe).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- The call's voices -----------------------------------------------
# FIRST VOICE - OpenAI (OPENAI_API_KEY above): engine "openai" reads the
# live call with the calm male register (voice Onyx). THE OPENAI LAW:
# calls only.
# SECOND VOICE - Gemini: when the OpenAI key is absent or rests, the
# SAME GEMINI_API_KEY speaks the call through the Gemini TTS sky with a
# prebuilt calm male voice. Without either key, the house's own warm
# male engine serves - nothing breaks. Optional knobs:
# GOOGLE_TTS_MODEL=gemini-2.5-flash-preview-tts
# GOOGLE_TTS_VOICE=Charon
CREDENTIALS_KEY=

# ── EMAIL CONFIRMATION & FORGOT PASSWORD (the six-digit letters) ───
# RESEND_API_KEY — resend.com → API Keys. Already configured on Vercel.
#   When set: registration waits for a six-digit email confirmation
#   (single-use, expires in 10 minutes, hashed at rest, rate-limited)
#   and normal sign-in stays email + password with NO code.
# RESEND_API_KEY=
# MAIL_FROM — a VERIFIED domain sender, e.g. "ReflectMe <letters@reflectme.space>"
#   (Resend's sandbox sender onboarding@resend.dev can only deliver to
#   your own account's email — set a verified domain for real users):
# MAIL_FROM=
# APP_URL — the public origin (https://www.reflectme.space) for letters:
# APP_URL=

# ── COMPLIMENTARY PAYMENT MODE (the FREE door at checkout) ─────────
# The master switches. The environment seeds the defaults; the keeper's
# admin hand (ADMIN_EMAIL session → /api/admin/complimentary, also the
# Account modal's owner panel) overrides them live without a redeploy.
#   COMPLIMENTARY_CHECKOUT — the FREE activation door at checkout
#   (defaults OPEN for the development phase when unset):
# COMPLIMENTARY_CHECKOUT=true
#   OPEN_ACCESS_MODE — the whole laboratory opens freely:
OPEN_ACCESS_MODE=false
#   CREDINS_ENABLED — the future bank gateway's readiness flag
#   (false until CredIns connects; Stripe remains the paid gateway):
CREDINS_ENABLED=false
#   A script key for the same hand (x-admin-key header), optional:
# ADMIN_KEY=
